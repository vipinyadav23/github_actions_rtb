# New repos created after 2026-07-15 default to immutable subjects:
# repo:YOUR_GITHUB_ORG@OWNER_ID/YOUR_REPO@REPO_ID:ref:refs/heads/main
oidc_subject = "repo:YOUR_GITHUB_ORG/YOUR_REPO:ref:refs/heads/main"
